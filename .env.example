# ─── Lunabotics Autonomy Command Center ───────────────────────────────────────
# Copy to .env.local. Never commit real values. Everything without NEXT_PUBLIC_
# stays on the server.

# Local (no Supabase) mode — required in production for signed session cookies.
SESSION_SECRET=replace-with-a-long-random-string
# Where the local JSON store lives (local/demo mode only).
DATA_FILE=.data/db.json
# Show the clearly labeled demo accounts on the sign-in page.
# Defaults to true without Supabase and false with it.
DEMO_ACCOUNTS=true
# Canonical public URL (no trailing slash), used in auth emails, OAuth redirects and
# invite links. On Vercel, defaults to the production domain; set it for a custom domain.
SITE_URL=
# Comma-separated emails that become administrators on first sign-in.
# If empty in local mode, the first real account registered becomes administrator.
ADMIN_EMAILS=

# ─── Supabase (production) ───────────────────────────────────────────────────
# Setting all three switches the app to Supabase Auth + PostgreSQL + Realtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS; used after application-level authorization.
SUPABASE_SERVICE_ROLE_KEY=

# GitHub OAuth sign-in (configure the provider in Supabase first).
NEXT_PUBLIC_GITHUB_OAUTH_ENABLED=false

# ─── Integrations (optional) ─────────────────────────────────────────────────
# Fine-grained, read-only token (public repos / your team repo only). Server only.
GITHUB_TOKEN=
# Discord webhook for team summaries: blockers, review requests, sprint starts.
DISCORD_WEBHOOK_URL=
