# ─── Lunabotics Autonomy Command Center ───────────────────────────────────────
# Copy to .env.local. Never commit real values. Everything without NEXT_PUBLIC_
# stays on the server.

# Signs the admin session cookie. REQUIRED in production (Vercel included); use a long
# random string, e.g. `openssl rand -base64 48`.
SESSION_SECRET=replace-with-a-long-random-string
# Where the local JSON store lives (local/demo mode only).
DATA_FILE=.data/db.json
# Show the clearly labeled demo personas on the admin page (local testing only).
# Defaults to true without Supabase and false with it.
DEMO_ACCOUNTS=true
# Anyone can view the board without an account. The unlisted /admin page asks for
# this password and unlocks adding and changing data. Set the real value only in
# .env.local and in Vercel; never commit it. Changing it signs every admin out.
ADMIN_PASSWORD=

# ─── Supabase (production) ───────────────────────────────────────────────────
# Setting all three switches storage to Supabase PostgreSQL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS; used after application-level authorization.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Integrations (optional) ─────────────────────────────────────────────────
# Fine-grained, read-only token (public repos / your team repo only). Server only.
GITHUB_TOKEN=
# Discord webhook for team summaries: blockers, review requests, sprint starts.
DISCORD_WEBHOOK_URL=
# Optional: send assignment emails straight from /admin through Resend (https://resend.com).
# Without these, /admin opens a ready-made draft in Gmail or your email app instead.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Lunabotics Autonomy <autonomy@example.org>".
EMAIL_FROM=
